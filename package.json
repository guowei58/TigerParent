{
  "name": "tiger-parent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reseed-content": "tsx prisma/reseed-content.ts",
    "db:reseed-content:force": "tsx prisma/reseed-content.ts --force",
    "db:backfill-content-qa": "tsx --env-file=.env scripts/content-backfill.ts",
    "db:seed-sources": "tsx --env-file=.env scripts/seed-source-registry.ts",
    "db:import-banks": "tsx --env-file=.env scripts/import-question-banks.ts",
    "db:download-state-releases": "tsx --env-file=.env scripts/state-releases/import-all.ts --download-only",
    "db:import-state-releases": "tsx --env-file=.env scripts/state-releases/import-all.ts",
    "db:discover-state-releases": "tsx --env-file=.env scripts/state-releases/discover-targets.ts",
    "db:report-state-coverage": "tsx --env-file=.env scripts/report-state-coverage.ts",
    "db:find-all-state-problems": "tsx --env-file=.env scripts/state-releases/find-all-states.ts",
    "db:ensure-all-states": "tsx --env-file=.env scripts/state-releases/ensure-all-states.ts",
    "db:gap-fill-states": "tsx --env-file=.env scripts/state-releases/gap-fill-states.ts",
    "db:rebuild-state-manifest": "tsx scripts/state-releases/rebuild-manifest.ts",
    "db:import-state-pdfs": "tsx --env-file=.env scripts/state-releases/import-all.ts --import-only",
    "db:audit-external-sources": "tsx --env-file=.env scripts/audit-external-sources.ts",
    "db:import-external-catalog": "tsx --env-file=.env scripts/import-external-catalog.ts",
    "db:import-everything": "tsx --env-file=.env scripts/import-everything.ts",
    "db:import-state-only": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs --env-file=.env scripts/state-releases/import-all.ts --import-only",
    "db:report-banks": "tsx --env-file=.env scripts/report-bank-composition.ts",
    "db:seed-standards": "tsx --env-file=.env prisma/standards-seed.ts",
    "db:backfill-provenance": "tsx --env-file=.env scripts/content-provenance-backfill.ts",
    "db:backfill-mcq": "tsx --env-file=.env scripts/mcq-shuffle-backfill.ts",
    "db:dedupe-skills": "tsx --env-file=.env scripts/dedupe-legacy-skills.ts",
    "test:mcq-provenance": "tsx --env-file=.env scripts/test-mcq-provenance.ts",
    "test:content": "tsx --env-file=.env scripts/test-content-quality.ts",
    "db:reseed-videos": "tsx prisma/reseed-videos.ts",
    "db:setup": "prisma migrate dev && tsx prisma/seed.ts",
    "db:setup:render": "tsx scripts/setup-db.ts",
    "db:seed-concepts": "tsx --env-file=.env scripts/seed-concepts.ts",
    "db:ingest-pdf": "tsx --env-file=.env scripts/ingest-pdf.ts --",
    "assets:upload": "tsx --env-file=.env scripts/upload-pdf-assets.ts",
    "test:pdf-parsing": "tsx src/lib/pdf/__tests__/parsing.test.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/postcss": "^4",
    "bcryptjs": "^3.0.3",
    "canvas": "^3.2.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "pdf-parse": "^2.4.5",
    "pdf-to-img": "^6.1.0",
    "pdfjs-dist": "^5.6.205",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3"
  }
}
