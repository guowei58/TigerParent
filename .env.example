# Database (PostgreSQL)
# Local with Docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tigerparent?schema=public"
# Local dev with Render Postgres (no Docker):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/tigerparent?sslmode=require"

# Auth (use a stable value locally — changing it invalidates login cookies)
AUTH_SECRET="tigerparent-local-dev-secret-change-in-production-min32chars"
NEXTAUTH_URL=http://localhost:3001
PORT=3001

# Email (Resend — https://resend.com). Without RESEND_API_KEY, emails log to the console in dev.
RESEND_API_KEY=
EMAIL_FROM="TigerParent <onboarding@resend.dev>"

# Admin PDF practice (comma-separated emails allowed to access /admin when role is not ADMIN)
ADMIN_EMAILS=

# Student practice: set true to hide legacy question bank and use PDF uploads only
# PDF_PRACTICE_ONLY=false

# Optional: Deepseek for problem explanations (preferred)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional: OpenAI (text fallback + vision if EXPLANATION_VISION_* unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Explanation pipeline: DeepSeek text draft → Gemini vision (preferred) → OpenAI vision (fallback)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
EXPLANATION_VISION_API_KEY=
EXPLANATION_VISION_BASE_URL=https://api.openai.com/v1
EXPLANATION_VISION_MODEL=gpt-4o-mini

# Production practice images — pick ONE approach (see README Deploy section):
#
# Option A — Backblaze B2 (free tier, no Cloudflare):
# S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=tigerparent-assets
# PDF_ASSETS_PUBLIC_BASE_URL=https://f000.backblazeb2.com/file/tigerparent-assets
#
# Option B — Cloudflare R2 (if activation works):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=tigerparent-assets
# PDF_ASSETS_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
#
# Option C — Render persistent disk: no env vars needed; run scripts/sync-pdf-assets-to-render.ps1

# App
NODE_ENV=development
